{
  "name": "@pulse/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p .",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@pulse/config": "workspace:*",
    "@pulse/contracts": "workspace:*",
    "@pulse/db": "workspace:*",
    "@pulse/i18n": "workspace:*",
    "@pulse/insights": "workspace:*",
    "@pulse/mail": "workspace:*",
    "@pulse/storage": "workspace:*",
    "@sentry/node": "^11.6.0",
    "better-auth": "^1.7.7",
    "hono": "^4.13.13",
    "pino": "^10.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@pulse/jobs": "workspace:*",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  }
