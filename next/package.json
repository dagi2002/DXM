{
  "name": "pulse",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.3",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test --concurrency=1",
    "check": "turbo run typecheck lint test",
    "db:setup": "pnpm --filter @pulse/db run setup",
    "db:migrate": "pnpm --filter @pulse/db run migrate",
    "db:seed": "pnpm --filter @pulse/db run seed",
    "e2e": "pnpm --filter @pulse/web run e2e",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "eslint": "^10.12.0",
    "prettier": "^3.6.2",
    "turbo": "^2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
