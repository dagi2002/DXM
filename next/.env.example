# Copy to next/.env for local development. Production values live in the server's env file.
NODE_ENV=development
PORT=4100
LOG_LEVEL=info

# App role (RLS enforced). Created by `pnpm db:setup`.
DATABASE_URL=postgres://pulse_app:pulse_app_dev@localhost:5432/pulse_dev
# Owner role, used only for migrations/setup.
DATABASE_ADMIN_URL=postgres://YOUR_OS_USER@localhost:5432/pulse_dev

APP_URL=http://localhost:5174
API_URL=http://localhost:4100
TRUSTED_ORIGINS=

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Optional locally
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM="DXM Pulse <hello@dxmpulse.et>"
SENTRY_DSN=
# Number of reverse proxies in front of the API (Caddy in production = 1)
TRUST_PROXY_HOPS=0

# Telegram alerts (optional). No token = alerts off and Settings says so.
# Token from @BotFather; never commit it. Webhook secret: openssl rand -hex 24
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# AI suggested fixes (optional, off by default). Needs AI_ENABLED=1 and a key.
AI_ENABLED=0
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5
# AI calls per organization per calendar month (UTC)
AI_MONTHLY_BUDGET=100
